{
  "info": {
    "name": "LabMaker API",
    "description": "Testes da API do LabMaker: sucesso e erro de usuários, equipamentos e agendamentos.\n\nAntes de rodar: ajuste baseUrl (local ou Render) e o e-mail/senha do Líder nas variáveis da coleção. Rode a coleção inteira, na ordem: cada pedido usa o que o anterior criou. No fim ela remove o equipamento e desativa o aluno que criou.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Usuários",
      "item": [
        {
          "name": "Cadastrar aluno — 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailAluno\", \"aluno.postman.\" + Date.now() + \"@labmaker.dev\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"cadastro ok\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno de Teste Postman\",\n  \"email\": \"{{emailAluno}}\",\n  \"senha\": \"senha-teste-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "cadastro"
              ]
            }
          }
        },

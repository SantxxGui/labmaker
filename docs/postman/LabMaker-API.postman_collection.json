    {
      "name": "3. Agendamentos",
      "item": [
        {
          "name": "Horários livres do equipamento — 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let d = new Date(Date.now() - 3 * 3600e3 + 86400e3);",
                  "if (d.getUTCDay() === 0) d = new Date(d.getTime() + 86400e3);",
                  "pm.collectionVariables.set(\"dataReserva\", d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const livre = pm.response.json().slots.find((s) => s.disponivel);",
                  "pm.test(\"há um horário livre\", () => pm.expect(livre).to.be.an(\"object\"));",
                  "if (livre) pm.collectionVariables.set(\"inicioReserva\", livre.inicio);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipamentos/{{equipamentoId}}/disponibilidade?data={{dataReserva}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipamentos",
                "{{equipamentoId}}",
                "disponibilidade"
              ],
              "query": [
                {
                  "key": "data",
                  "value": "{{dataReserva}}"
                }
              ]
            }
          }
        },

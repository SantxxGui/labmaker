              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const aluno = pm.response.json().usuarios.find((u) => u.email === pm.collectionVariables.get(\"emailAluno\"));",

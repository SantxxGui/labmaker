# ── Banco de dados (PostgreSQL) ───────────────────────────────────────
# Supabase: Connect → Connection String → Session pooler → copie a URL
# e troque [YOUR-PASSWORD] pela senha do banco (sem os colchetes).
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# ── Sessão ────────────────────────────────────────────────────────────
# Qualquer texto com 32+ caracteres (você inventa). Obrigatório em produção;
# em desenvolvimento o app usa uma chave padrão se esta linha faltar.
AUTH_SECRET="troque-por-um-texto-aleatorio-com-32-ou-mais-caracteres"

# Opcional: esconde os atalhos de contas de demonstração na tela de login
# NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"

# ── Conta inicial (npm run db:reset cria o espaço ZERADO só com ela) ──
# O Líder (OED ou Estagiário EMK) cuida de tudo: cadastros, empréstimos, contas, senhas e auditoria.
# LIDER_EMAIL="lider@labmaker.dev"
# LIDER_SENHA="troque-esta-senha"
# LIDER_NOME="Paulo Sato"

# Cookie de sessão "Secure": automático (liga sozinho em HTTPS, inclusive atrás de túnel/proxy).
# Em produção atrás de HTTPS você pode forçar:
# COOKIE_SECURE="true"
